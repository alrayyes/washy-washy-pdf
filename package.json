{
  "name": "@washy-washy/pdf",
  "version": "2.6.5",
  "description": "The React/@react-pdf/renderer components that draw a chart into a PDF, shared by the CLI and the web app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrayyes/washy-washy-pdf.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:package-json && bun run lint:prose && bun run build && bun run test:dist && bun run typecheck && bun run lint:types-doc && bun test",
    "docs": "typedoc",
    "examples": "bun run scripts/examples.ts",
    "format": "prettier --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:package-json": "sort-package-json --check package.json",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' .",
    "lint:types-doc": "tsd --files \"test/*.test-d.ts\"",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "mutation": "stryker run",
    "prepack": "bun run build",
    "prepare": "lefthook install",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "screenshots": "bun run scripts/screenshots.ts",
    "test": "bun test",
    "test:dist": "bun test ./test/dist.smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@react-pdf/font": "4.0.11",
    "js-yaml": "5.4.3",
    "katex": "0.19.0",
    "markdown-it": "14.3.3",
    "qs": "6.16.0",
    "smol-toml": "1.9.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.7.0",
    "@washy-washy/core": "1.6.4",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.2",
    "pdf-lib": "1.17.1",
    "prettier": "3.10.1",
    "sort-package-json": "4.1.0",
    "tsd": "0.33.0",
    "tsdown": "0.23.7",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "tsd": {
    "compilerOptions": {
      "module": "nodenext"
    }
  }
}

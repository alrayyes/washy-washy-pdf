{
  "name": "@washy-washy/pdf",
  "version": "1.0.4",
  "description": "The React/@react-pdf/renderer components that draw a chart into a PDF, shared by the CLI and the web app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrayyes/washy-washy-pdf.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:package-json && bun run lint:prose && bun run typecheck && bun test",
    "docs": "typedoc",
    "format": "prettier --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:package-json": "sort-package-json --check package.json",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' .",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "prepack": "bun run build",
    "prepare": "lefthook install",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.6.1",
    "@washy-washy/core": "1.0.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "tsdown": "0.22.14",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
